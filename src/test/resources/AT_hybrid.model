% Feature Specification v1.0

FEATURES
consonantal   con    binary    %  0
sonorant      son    binary    %  1
continuant    cnt    binary    %  2
ejective      eje    binary    %  3
release       rel    binary    %  4
lateral       lat    binary    %  5
nasal         nas    binary    %  6
labial        lab    binary    %  7
round         rnd    binary    %  8
coronal       cor    binary    %  9
anterior      ant    binary    % 10
grooved       grv    binary    % 11
dorsal        dor    binary    % 12
front         frn    binary    % 13
back          bck    binary    % 14
high          hgh    binary    % 15
low           low    binary    % 16
atr           atr    binary    % 17
voice         vce    binary    % 18
creaky        crk    binary    % 19
breathy       brt    binary    % 20
distributed   dst    binary    % 21
long          lng    binary    % 22
short         sht    binary    % 23
accented      acc    binary    % 24
syllabic      syl    binary    % 25

ALIASES

% Symmetrical bundles where all features have the
% same specified polarity: all plus or all minus
[+vot] = [+breathy]
[-vot] = [-breathy]

[bilabial]  = [+labial +distributed]
[alveolar]  = [+coronal +anterior +grooved]
[retroflex] = [+coronal -anterior -grooved -distributed]
[palatal]   = [+coronal -anterior -grooved +distributed +front +high]
[velar]     = [+dorsal +back +high]
[uvular]    = [+dorsal +back +low]

% Asymmetrical selectors
[obstruent] = [-sonorant]
[vowel]     = [-consonantal +sonorant +continuant]

CONSTRAINTS

% Low cannot occur with High
[+high] > [-low]
[+low]  > [-high]

% Front cannot occur with Back
[+front] > [-back]
[+back]  > [-front]

% Short cannot occur with long
[+short] > [-long]
[+long]  > [-short]

% [+nas] and [+lat] cannot co-occur
[+nasal]   > [-lateral]
[+lateral] > [-nasal]

% [-con] and [-son] cannot co-occur
[-sonorant]    > [+consonantal]
[-consonantal] > [+sonorant]

% [continuant] only applies to [+consonantal]
[-continuant]  > [+consonantal]
[-consonantal] > [+continuant]

% Segment can only be [+rel] if it is also [+consonantal, -continuant]
[+release]     > [+consonantal]
[+release]     > [-sonorant]

[-consonantal] > [-release]
[+continuant]  > [-release]
[+sonorant]    > [-release]

% Only obstruents (stops?) can be ejectives
[+ejective] > [+consonantal -sonorant -continuant -voice]

[+sonorant]    > [-ejective]
[-consonantal] > [-ejective]
[+continuant]  > [-ejective]
[+voice]       > [-ejective]

% Distrubuted requires a closure or near closure
[+distributed] > [+consonantal]
[-consonantal] > [-distributed]

% Obstruents default to ATR for no strong reason
[-son] > [-atr]
[+atr] > [+son]

[+creaky]  > [-breathy +voice]
[+breathy] > [-creaky]


